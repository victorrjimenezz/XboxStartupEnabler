<Window x:Class="XboxStartupEnabler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xbox Startup Enabler"
        Icon="icon.ico"
        Width="780"
        MinWidth="640"
        SizeToContent="Height"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28 22 28 24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header        -->
            <RowDefinition Height="Auto"/>   <!-- status banner -->
            <RowDefinition Height="Auto"/>   <!-- target cards  -->
            <RowDefinition Height="Auto"/>   <!-- buttons       -->
            <RowDefinition Height="Auto"/>   <!-- activity log  -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0 0 0 18">
            <TextBlock Text="Xbox Startup Enabler" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Foreground="{StaticResource TextMuted}" Margin="0 4 0 0" FontSize="13">
                Unlocks the &quot;Choose your home app&quot; option on Windows 11 desktops by patching
                three Windows DLLs.
            </TextBlock>
        </StackPanel>

        <!-- Big status banner -->
        <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="8"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                Padding="18 16" Margin="0 0 0 14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="#888"
                         VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="14 0 0 0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusHeadline" Text="Checking..." FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusDetail"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="12" Margin="0 2 0 0"/>
                </StackPanel>
                <TextBlock Grid.Column="2" x:Name="ElevationBadge"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Warn}"
                           FontSize="12" FontWeight="SemiBold"
                           Visibility="Collapsed"
                           Text="⚠ NOT ELEVATED"/>
            </Grid>
        </Border>

        <!-- Patch site list -->
        <Border Grid.Row="2" Background="{StaticResource Card}" CornerRadius="8"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                Padding="6 6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TargetsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Margin="6 4" Padding="14 12"
                                    Background="{StaticResource CardAlt}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SubLine}"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontSize="11" Margin="0 2 0 0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StateLabel}"
                                                   Foreground="{Binding StateBrush}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Sites}" Margin="0 10 0 0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0 3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="8" Height="8"
                                                             Fill="{Binding StateBrush}"
                                                             VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Description}"
                                                               Margin="10 0 0 0"
                                                               FontSize="12.5"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding StateLabel}"
                                                               Foreground="{Binding StateBrush}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Action buttons -->
        <Grid Grid.Row="3" Margin="0 16 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left"
                    x:Name="RefreshBtn" Content="↻ Refresh"
                    Click="OnRefreshClick"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}"
                        x:Name="RestoreBtn" Content="Restore originals"
                        Margin="0 0 10 0" Click="OnRestoreClick"/>
                <Button Style="{StaticResource PrimaryButton}"
                        x:Name="ApplyBtn" Content="Apply patches"
                        Click="OnApplyClick"/>
            </StackPanel>
        </Grid>

        <!-- Collapsible log -->
        <Expander Grid.Row="4" x:Name="LogExpander" Header="Activity log"
                  Foreground="{StaticResource TextMuted}" Margin="0 14 0 0">
            <Border Background="{StaticResource Card}" CornerRadius="6"
                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                    Padding="12" Margin="0 8 0 0" MaxHeight="180">
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="LogBox"
                             Background="Transparent"
                             Foreground="{StaticResource TextMuted}"
                             FontFamily="Consolas, Cascadia Mono, Lucida Console"
                             FontSize="11.5"
                             BorderThickness="0"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>
                </ScrollViewer>
            </Border>
        </Expander>
    </Grid>
</Window>
